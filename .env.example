# MySQL Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=interactive_minds
DB_USER=root
DB_PASSWORD=your_database_password

# Security & JWT
JWT_SECRET=your_random_jwt_secret_minimum_32_characters
SESSION_SECRET=your_random_session_secret_minimum_32_characters

# Site Info
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAIL=admin@interactivemind.in

# SMTP Email Notification Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Interactive Minds <noreply@interactivemind.in>"
ADMIN_NOTIFICATION_EMAIL=admin@interactivemind.in

# Node Environment
NODE_ENV=development
